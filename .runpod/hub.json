{
  "title": "Qwen Image Edit (8-bit quantized)",
  "description": "Qwen Image Edit with bitsandbytes 8-bit quantization — fits on 24GB GPU",
  "type": "serverless",
  "category": "image",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 20,
    "presets": [
      {
        "name": "24GB GPU",
        "gpuIds": "24GB",
        "minWorkers": 0,
        "maxWorkers": 3,
        "idleTimeout": 300,
        "scalerType": "QUEUE_DELAY",
        "scalerValue": 1
      }
    ],
    "env": []
  }
}
